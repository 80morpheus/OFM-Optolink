<?xml version="1.0" encoding="utf-8"?>
<?xml-model href="../../../../Organization/knxprod-support/knx_project_20/knx-editor.xsd" type="application/xml" schematypens="http://www.w3.org/2001/XMLSchema"?>
<KNX xmlns:op="http://github.com/OpenKNX/OpenKNXproducer" xmlns="http://knx.org/xml/project/20" CreatedBy="KNX MT" ToolVersion="5.1.255.16695">

  <ManufacturerData>
    <Manufacturer>
      <ApplicationPrograms>
        <ApplicationProgram>


          <Static>
            <ParameterTypes>
              

              <ParameterType Id="%AID%_PT-HeaterTyp" Name="Heizungstyp">
                <TypeRestriction Base="Value" SizeInBit="6" UIHint="DropDown">
                  <Enumeration Text="Deaktiviert"   Value="0" Id="%ENID%" />
                  <Enumeration Text="Vitocal 200 A WO1C" Value="1" Id="%ENID%" />
                  <Enumeration Text="Vitocal 250 A" Value="2" Id="%ENID%" />
                  <Enumeration Text="Vitocal 300 A" Value="3" Id="%ENID%" />
                  <!-- 4 bit free -->
                </TypeRestriction>
              </ParameterType>

              <ParameterType Id="%AID%_PT-HardwareVersion" Name="Hardwareversion">
                <TypeRestriction Base="Value" SizeInBit="2" UIHint="DropDown">
                  <Enumeration Text="Deaktiviert" Value="0" Id="%ENID%" />
                  <Enumeration Text="Reg1 Base  " Value="1" Id="%ENID%" />
                  <Enumeration Text="UP1 GW UART" Value="2" Id="%ENID%" />
                  <Enumeration Text="           " Value="3" Id="%ENID%" />
                </TypeRestriction>
              </ParameterType>
              <ParameterType Id="%AID%_PT-IntervalTime" Name="IntervalTime">
                <TypeNumber SizeInBit="12" Type="unsignedInt" minInclusive="30" maxInclusive="4095" />
              </ParameterType>

            </ParameterTypes>

            <Parameters>      
              <op:include href="OptolinkModule_200A.xml" xpath="//ApplicationProgram/Static/Parameters/Union" type="template" prefix="OPTO_200_Par" />
              
 
              <Union SizeInBit="8">
                <Memory CodeSegment="%AID%_RS-04-00000" Offset="0" BitOffset="0" />
                <Parameter Id="%AID%_UP-%TT%00001" Name="HardwareVersion"           ParameterType="%AID%_PT-HardwareVersion" Offset="0" BitOffset="0" Text="Hardware-Version" Value="0" />
                <Parameter Id="%AID%_UP-%TT%00002" Name="HeaterType"                ParameterType="%AID%_PT-HeaterType"      Offset="0" BitOffset="2" Text="HeaterType"       Value="0" />
                <!-- 4 bit free -->
              </Union>
              
           </Parameters>

            <ParameterRefs>
              <op:include href="OptolinkModule_200A.xml" xpath="//ApplicationProgram/Static/ParameterRefs/ParameterRef" type="template" prefix="OPTO_200_Par_Ref" />

              <ParameterRef Id="%AID%_UP-%TT%00001_R-%TT%0000101" RefId="%AID%_UP-%TT%00001" />
              <ParameterRef Id="%AID%_UP-%TT%00002_R-%TT%0000201" RefId="%AID%_UP-%TT%00002" />

            </ParameterRefs>

            <ComObjectTable>
            </ComObjectTable>

            <ComObjectRefs>
            </ComObjectRefs>

            <Extension>
              <Baggage RefId="%FILE-HELP-de%" />
              <Baggage RefId="%FILE-ICONS%" />
              <Baggage RefId="%FILE-openknx%" />
              <Baggage RefId="%FILE-pics-and%" />
              <Baggage RefId="%FILE-pics-or%" />
            </Extension>
          </Static>

          <Dynamic>
            <Channel Name="Optolink" Text="Optolink" Number="%PREFIX%" Id="%AID%_CH-%PREFIX%" HelpContext="Empty" >
              <ParameterBlock Id="%AID%_PB-nnn" Name="Settings" Text="Allgemein" Icon="cog-outline" ShowInComObjectTree="true">
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Optolink" UIHint="Headline" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Version: %ModuleVersion%" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />

                <ParameterSeparator Id="%AID%_PS-nnn" Text="Hardwarezuordnung" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%00001_R-%TT%0000101" IndentLevel="1"  />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="" UIHint="HorizontalRuler" />
                <ParameterSeparator Id="%AID%_PS-nnn" Text="Auswahl Heizungstyp" UIHint="Headline" />
                <ParameterRefRef RefId="%AID%_UP-%TT%00002_R-%TT%0000201" IndentLevel="1"  />

              </ParameterBlock>
              
                <choose ParamRefId="%AID%_UP-%TT%00002_R-%TT%0000201"> <!-- Heater Type -->
                  <when test="1">
                    <!--<ParameterBlock Id="%AID%_PB-nnn" Name="AssignmentTable_200A" Text="Zuordnungstabelle_200A" Icon="cog-outline" ShowInComObjectTree="true">-->
                    <op:include href="OptolinkModule_200A.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock/*" type="template" prefix="OPTO_200A" IsInner="true" />
                    <!--</ParameterBlock>-->
                  </when>
                  <when test="2">
                    <ParameterBlock Id="%AID%_PB-nnn" Name="AssignmentTable_250A" Text="Zuordnungstabelle_250A" Icon="cog-outline" ShowInComObjectTree="true">
                    <!--<op:include href="OptolinkModule_250A.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='AssignmentTable_250A']/*" prefix="OPTO" type="template" IsInner="true" />--> 
                  </ParameterBlock>
                  </when>
                  <when test="3">
                    <ParameterBlock Id="%AID%_PB-nnn" Name="AssignmentTable_300A" Text="Zuordnungstabelle_300A" Icon="cog-outline" ShowInComObjectTree="true">
                    <!--<op:include href="OptolinkModule_300A.xml" xpath="//Dynamic/ChannelIndependentBlock/ParameterBlock[@Name='AssignmentTable_300A']/*" prefix="OPTO" type="template" IsInner="true" />-->
                    </ParameterBlock>
                  </when>
                </choose>
                
              

              
            </Channel>

          </Dynamic>

        </ApplicationProgram>
      </ApplicationPrograms>
      <Baggages>
        <Baggage TargetPath="" Name="Help_de.zip" Id="%FILE-HELP-de%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
        <Baggage TargetPath="" Name="Icons.zip" Id="%FILE-ICONS%">
          <FileInfo TimeInfo="%DATETIME%" />
        </Baggage>
      </Baggages>
    </Manufacturer>
  </ManufacturerData>
</KNX>
